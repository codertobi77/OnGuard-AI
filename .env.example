# ---------------------------------------------------------------------------
# OnGuard AI — environment variables
# Copy to .env.local and fill in real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local admin/superuser credentials are fine for local development.
DATABASE_URL="postgresql://postgres:password@localhost:5432/onguard_db"

# OpenRouter API key (https://openrouter.ai/keys) — OPTIONAL.
# When absent, OnGuard AI runs in demo mode and uses the built-in
# deterministic heuristic engine instead of the vision LLM.
OPENROUTER_API_KEY=""

# Multimodal vision model used by the analysis engine.
# Must accept image input on OpenRouter. Alternatives: any vision model id.
AI_MODEL="z-ai/glm-4.5v"
